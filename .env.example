# Copie este arquivo para ".env.local" e preencha com sua chave real.
# Nunca commite o arquivo .env.local (ele já está no .gitignore).

# Chave de API da Anthropic — gere em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo usado para selecionar o repertório e gerar as explicações de uso.
# Haiku é rápido e barato; troque por um modelo mais robusto se quiser respostas mais elaboradas.
ANTHROPIC_MODEL=claude-haiku-4-5
